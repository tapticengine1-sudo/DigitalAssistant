<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ptako_bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Настройки"
            android:textColor="@color/ptako_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="DeepSeek API-ключ"
            android:textColor="@color/ptako_text_muted" />

        <EditText
            android:id="@+id/apiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="sk-..."
            android:inputType="textPassword"
            android:textColor="@color/ptako_text"
            android:textColorHint="@color/ptako_text_muted" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchSpeak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Озвучивать ответы"
            android:textColor="@color/ptako_text" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchMultimodal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Мультимодальный режим (изображения в API)"
            android:textColor="@color/ptako_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Модель для изображений"
            android:textColor="@color/ptako_text_muted" />

        <EditText
            android:id="@+id/visionModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="deepseek-chat"
            android:inputType="text"
            android:textColor="@color/ptako_text"
            android:textColorHint="@color/ptako_text_muted" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Сохранить" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Доступы"
            android:textColor="@color/ptako_text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDefault"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Назначить помощником по умолчанию" />

        <Button
            android:id="@+id/btnPerms"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Микрофон, звонки, контакты, уведомления" />

        <Button
            android:id="@+id/btnWrite"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Изменение системных настроек" />

        <Button
            android:id="@+id/btnDnd"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Режим «Не беспокоить»" />
    </LinearLayout>
</ScrollView>
