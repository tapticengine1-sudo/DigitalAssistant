<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_assist_sheet"
    android:elevation="12dp"
    android:orientation="vertical"
    android:paddingTop="8dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="6dp"
        android:background="@color/ptako_stroke" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="6dp"
        android:text="@string/app_name"
        android:textColor="@color/ptako_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:clipToPadding="false"
        android:paddingBottom="4dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/attachPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/ptako_blue_soft"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="10dp">

        <Button
            android:id="@+id/btnAttach"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:contentDescription="Вложение"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="📎"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_write"
            android:imeOptions="actionSend"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:textColor="@color/ptako_text"
            android:textColorHint="@color/ptako_text_muted" />

        <Button
            android:id="@+id/btnMic"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:contentDescription="@string/hold_to_talk"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="🎤"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnSend"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:contentDescription="Отправить"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="➤"
            android:textColor="@color/ptako_blue_soft"
            android:textSize="22sp" />
    </LinearLayout>
</LinearLayout>
